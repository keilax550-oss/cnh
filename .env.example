# ── Pingupag ──────────────────────────────────────────────────────────────────
# Chave Secreta obtida em: Portal Pingupag → Configurações e API → Secret Key
PINGUPAG_API_KEY=pingupag_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AvenPayments (gateway atual) ──────────────────────────────────────────────
AVEN_API_KEY=your_aven_api_key_here

# ── WinnerPay (gateway legada) ────────────────────────────────────────────────
WINNER_CLIENT_ID=your_client_id_here
WINNER_CLIENT_SECRET=your_client_secret_here

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── UTMify ────────────────────────────────────────────────────────────────────
UTMIFY_TOKEN=your_utmify_token_here

# ── URL pública do site (usada para montar o postback_url) ────────────────────
URL=https://your-netlify-site.netlify.app
